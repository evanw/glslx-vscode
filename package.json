{
  "name": "glslx-vscode",
  "description": "A language service for GLSLX",
  "version": "0.2.1",
  "publisher": "evanw",
  "repository": {
    "type": "git",
    "url": "https://github.com/evanw/glslx-vscode"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.52.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:glslx"
  ],
  "scripts": {
    "vscode:prepublish": "tsc"
  },
  "main": "./src/extension",
  "contributes": {
    "languages": [
      {
        "id": "glslx",
        "aliases": [
          "GLSLX",
          "glslx"
        ],
        "extensions": [
          ".glslx"
        ],
        "configuration": "./glslx.configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "glslx",
        "scopeName": "source.glslx",
        "path": "./syntaxes/GLSLX.tmLanguage"
      }
    ]
  },
  "dependencies": {
    "glslx": "0.4.3"
  },
  "devDependencies": {
    "@types/node": "16.18.126",
    "@types/vscode": "1.52.0",
    "typescript": "7.0.2"
  }
}
